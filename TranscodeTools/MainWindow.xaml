<Window x:Class="TranscodeTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:TranscodeTools"
        Title="Transcode Tools"
        Width="1100" Height="820"
        MinWidth="800" MinHeight="600"
        Background="{DynamicResource WindowBg}"
        Loaded="MainWindow_Loaded">

    <Window.Resources>
        <!-- Mode switcher radio button style -->
        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TreeView item style — applies theme colours and green highlight -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="2,2"/>
            <Setter Property="IsExpanded" Value="False"/>
        </Style>
        <!-- Transcode dropdown option lists -->
        <x:Array x:Key="VideoResolutionOptions" Type="sys:String">
            <sys:String>Keep</sys:String>
            <sys:String>480p</sys:String>
            <sys:String>720p</sys:String>
            <sys:String>1080p</sys:String>
            <sys:String>2160p</sys:String>
        </x:Array>
        <x:Array x:Key="VideoOutputFormatOptions" Type="sys:String">
            <sys:String>hevc (default)</sys:String>
            <sys:String>h.264</sys:String>
        </x:Array>
        <x:Array x:Key="VideoPresetOptions" Type="sys:String">
            <sys:String>p1</sys:String>
            <sys:String>p2</sys:String>
            <sys:String>p3</sys:String>
            <sys:String>p4</sys:String>
            <sys:String>p5</sys:String>
            <sys:String>p6</sys:String>
            <sys:String>p7</sys:String>
        </x:Array>
        <x:Array x:Key="VideoFrameRateOptions" Type="sys:String">
            <sys:String>Keep</sys:String>
            <sys:String>30000/1001</sys:String>
            <sys:String>24000/1001</sys:String>
        </x:Array>
        <x:Array x:Key="AudioFormatOptions" Type="sys:String">
            <sys:String>Keep</sys:String>
            <sys:String>eac3</sys:String>
            <sys:String>ac3</sys:String>
        </x:Array>
        <x:Array x:Key="AudioWidthOptions" Type="sys:String">
            <sys:String>Keep</sys:String>
            <sys:String>Surround</sys:String>
            <sys:String>Stereo</sys:String>
            <sys:String>Mono</sys:String>
        </x:Array>
        <x:Array x:Key="AudioBitRateOptions" Type="sys:String">
            <sys:String>Keep</sys:String>
            <sys:String>1536</sys:String>
            <sys:String>768</sys:String>
            <sys:String>640</sys:String>
            <sys:String>320</sys:String>
            <sys:String>192</sys:String>
        </x:Array>
    </Window.Resources>

    <DockPanel>

        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource SurfaceBg}"
              BorderBrush="{DynamicResource SeparatorColor}"
              BorderThickness="0,0,0,1">
            <MenuItem Header="File">
                <MenuItem Header="Open Input Directory"  Click="OpenInputDirectory_Click"/>
                <MenuItem Header="Open Output Directory" Click="OpenOutputDirectory_Click"/>
                <MenuItem x:Name="RunMenuItem" Header="Run Remux" Click="Run_Click"/>
                <Separator Style="{StaticResource {x:Static MenuItem.SeparatorStyleKey}}"/>
                <MenuItem Header="Preferences"           Click="Preferences_Click"/>
                <Separator Style="{StaticResource {x:Static MenuItem.SeparatorStyleKey}}"/>
                <MenuItem Header="Exit"                  Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Mode switcher toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceBg}"
                BorderBrush="{DynamicResource SeparatorColor}"
                BorderThickness="0,0,0,1"
                Padding="12,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="User Mode:"
                           Foreground="{DynamicResource SubtleForeground}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <RadioButton x:Name="RemuxRadio"
                             Content="Remux"
                             Style="{StaticResource ModeRadio}"
                             IsChecked="True"
                             Checked="ModeChanged"/>
                <RadioButton x:Name="TranscodeRadio"
                             Content="Transcode"
                             Style="{StaticResource ModeRadio}"
                             Checked="ModeChanged"/>
            </StackPanel>
        </Border>

        <!-- Bottom button bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SurfaceBg}"
                BorderBrush="{DynamicResource SeparatorColor}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <!-- Left-aligned playback/utility buttons (Remux only) -->
                <StackPanel x:Name="RemuxButtons" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="OpenInMPVBtn"
                            Content="Open in MPV"
                            Style="{StaticResource FlatButton}"
                            Margin="0,0,8,0"
                            Click="OpenInMPV_Click"/>
                    <Button x:Name="OpenInSubtitleEditBtn"
                            Content="Open in SubtitleEdit"
                            Style="{StaticResource FlatButton}"
                            Margin="0,0,8,0"
                            Click="OpenInSubtitleEdit_Click"/>
                    <Button x:Name="OpenFolderBtn"
                            Content="Open Folder in Explorer"
                            Style="{StaticResource FlatButton}"
                            Click="OpenFolderInExplorer_Click"/>
                </StackPanel>

                <!-- Right-aligned save button -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="ViewRemuxCommandBtn"
                            Content="View Command"
                            Style="{StaticResource FlatButton}"
                            IsEnabled="False"
                            Margin="0,0,8,0"
                            Click="ViewCommand_Click"/>
                    <Button x:Name="ViewTranscodeCommandBtn"
                            Content="View Command"
                            Style="{StaticResource FlatButton}"
                            Visibility="Collapsed"
                            Margin="0,0,8,0"
                            Click="ViewCommand_Click"/>
                    <Button x:Name="SaveRemuxBtn"
                            Content="Save Remux Settings"
                            Style="{StaticResource AccentButton}"
                            Click="SaveSettings_Click"/>
                    <Button x:Name="SaveTranscodeBtn"
                            Content="Save Transcode Settings"
                            Style="{StaticResource AccentButton}"
                            Visibility="Collapsed"
                            Click="SaveSettings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content area -->
        <Grid Margin="12,10,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>       <!-- Directory pickers -->
                <RowDefinition Height="200"/>      <!-- File browser panels -->
                <RowDefinition Height="Auto"/>     <!-- Selected file bar -->
                <RowDefinition Height="*"/>        <!-- Track tables -->
            </Grid.RowDefinitions>

            <!-- Directory pickers row -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Input directory -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Input Directory"
                            Style="{StaticResource FlatButton}"
                            Margin="0,0,6,0"
                            Click="OpenInputDirectory_Click"/>
                    <!-- IsEditable="False" keeps the text portion read-only;
                         IsReadOnly="True" on the inner TextBox prevents typing.
                         The dropdown arrow opens the history list. -->
                    <ComboBox Grid.Column="1"
                              x:Name="InputDirectoryBox"
                              IsEditable="True"
                              IsReadOnly="True"
                              SelectionChanged="InputDirectoryBox_SelectionChanged"/>
                </Grid>

                <!-- Output directory -->
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Output Directory"
                            Style="{StaticResource FlatButton}"
                            Margin="0,0,6,0"
                            Click="OpenOutputDirectory_Click"/>
                    <ComboBox Grid.Column="1"
                              x:Name="OutputDirectoryBox"
                              IsEditable="True"
                              IsReadOnly="True"
                              SelectionChanged="OutputDirectoryBox_SelectionChanged"/>
                </Grid>
            </Grid>

            <!-- File browser panels -->
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <!-- Left list (movie folders) takes 40% of width -->
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="8"/>
                    <!-- Right TreeView (files within selected folder) takes 60% -->
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: folder/show browser -->
                <Border Grid.Column="0"
                        Background="{DynamicResource PanelBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <TreeView x:Name="FolderList"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{DynamicResource ForegroundColor}"
                              FontSize="13"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectedItemChanged="FolderList_SelectedItemChanged">
                        <TreeView.Resources>
                            <!-- Movie folder: leaf node, no children -->
                            <DataTemplate DataType="{x:Type local:FolderNode}">
                                <TextBlock Text="{Binding DisplayName}" Padding="2,1"/>
                            </DataTemplate>
                            <!-- TV show: expandable node with season children -->
                            <HierarchicalDataTemplate DataType="{x:Type local:ShowNode}"
                                                      ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding DisplayName}" Padding="2,1"/>
                            </HierarchicalDataTemplate>
                            <!-- Season: leaf node inside a show -->
                            <DataTemplate DataType="{x:Type local:SeasonNode}">
                                <TextBlock Text="{Binding DisplayName}" Padding="2,1"/>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Border>

                <!-- Right: TreeView of files within the selected folder -->
                <Border Grid.Column="2"
                        Background="{DynamicResource PanelBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <TreeView x:Name="FileTree"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{DynamicResource ForegroundColor}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectedItemChanged="FileTree_SelectedItemChanged">
                        <TreeView.Resources>
                            <!-- Group node template: shows category name with expand arrow -->
                            <HierarchicalDataTemplate DataType="{x:Type local:FileGroupNode}"
                                                      ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding DisplayName}"
                                           Background="{Binding Background}"
                                           Padding="2,1"/>
                            </HierarchicalDataTemplate>

                            <!-- Leaf node template: shows individual file name -->
                            <DataTemplate DataType="{x:Type local:FileLeafNode}">
                                <TextBlock Text="{Binding DisplayName}"
                                           Background="{Binding Background}"
                                           Padding="2,1"/>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Border>
            </Grid>

            <!-- Selected file bar — shows which file's tracks are displayed below -->
            <!-- Hidden until a file is selected -->
            <Border Grid.Row="2"
                    x:Name="SelectedFileBar"
                    Background="{DynamicResource SurfaceBg}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,8,0,0"
                    Padding="10,6"
                    Visibility="Collapsed">
                <TextBlock x:Name="SelectedFileLabel"
                           Foreground="{DynamicResource ForegroundColor}"
                           FontSize="13"
                           FontWeight="SemiBold"/>
            </Border>

            <!-- Track panels -->
            <Grid Grid.Row="3" Margin="0,8,0,0">

                <!-- REMUX MODE -->
                <Grid x:Name="RemuxPanel">
                    <Grid.RowDefinitions>
                        <!-- Video: auto-sizes to content, almost always one row -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto" MinHeight="52" MaxHeight="104"/>
                        <RowDefinition Height="8"/>
                        <!-- Audio: takes a proportional share of remaining space -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="52"/>
                        <RowDefinition Height="8"/>
                        <!-- Subtitles: takes a proportional share of remaining space -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="52"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="VIDEO" Style="{StaticResource SectionLabel}"/>

                    <!-- Video — display only, no selection checkbox, no drag -->
                    <ListView Grid.Row="1"
                              x:Name="RemuxVideoList"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource BorderColor}"
                              IsHitTestVisible="False"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <!-- IsHitTestVisible=False makes the whole list non-interactive -->
                        <!-- The user cannot select rows or click checkboxes -->
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Video Format" Width="180" DisplayMemberBinding="{Binding VideoFormat}"/>
                                <GridViewColumn Header="Resolution"   Width="120" DisplayMemberBinding="{Binding Resolution}"/>
                                <GridViewColumn Header="fps"          Width="120" DisplayMemberBinding="{Binding Fps}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock Grid.Row="3" Text="AUDIO" Style="{StaticResource SectionLabel}"/>

                    <!-- Audio — selectable rows, drag to reorder -->
                    <ListView Grid.Row="4"
                              x:Name="RemuxAudioList"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource BorderColor}"
                              SelectionMode="Single"
                              AllowDrop="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              PreviewMouseLeftButtonDown="AudioList_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="AudioList_PreviewMouseMove"
                              MouseLeftButtonUp="AudioList_MouseLeftButtonUp"
                              Drop="AudioList_Drop">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="30">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" ToolTip="Include in output"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Audio Format"    Width="150" DisplayMemberBinding="{Binding AudioFormat}"/>
                                <GridViewColumn Header="Width"           Width="90"  DisplayMemberBinding="{Binding Width}"/>
                                <GridViewColumn Header="Bit Rate (Kbps)" Width="110" DisplayMemberBinding="{Binding BitRate}"/>
                                <GridViewColumn Header="Language"        Width="90"  DisplayMemberBinding="{Binding Language}"/>
                                <GridViewColumn Header="Title"           Width="160" DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="Default"         Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsDefault}" IsEnabled="False"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock Grid.Row="6" Text="SUBTITLES" Style="{StaticResource SectionLabel}"/>

                    <!-- Subtitles — selectable rows, drag to reorder, no Title column -->
                    <ListView Grid.Row="7"
                              x:Name="RemuxSubtitleList"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource BorderColor}"
                              SelectionMode="Single"
                              AllowDrop="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              PreviewMouseLeftButtonDown="SubtitleList_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="SubtitleList_PreviewMouseMove"
                              MouseLeftButtonUp="SubtitleList_MouseLeftButtonUp"
                              Drop="SubtitleList_Drop">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="30">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" ToolTip="Include in output"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Subtitle Format" Width="150" DisplayMemberBinding="{Binding SubtitleFormat}"/>
                                <GridViewColumn Header="Language"        Width="90"  DisplayMemberBinding="{Binding Language}"/>
                                <GridViewColumn Header="# of Frames"     Width="100" DisplayMemberBinding="{Binding FrameCount}"/>
                                <GridViewColumn Header="Default"         Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsDefault}" IsEnabled="False"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Forced" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsForced}" IsEnabled="False"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <!-- TRANSCODE MODE -->
                <Grid x:Name="TranscodePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- Video: auto-sizes to content, almost always one row -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto" MinHeight="52" MaxHeight="104"/>
                        <RowDefinition Height="8"/>
                        <!-- Audio: takes a proportional share of remaining space -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="52"/>
                        <RowDefinition Height="8"/>
                        <!-- Subtitles: takes a proportional share of remaining space -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="52"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="VIDEO" Style="{StaticResource SectionLabel}"/>

                    <ListView Grid.Row="1" x:Name="TranscodeVideoList"
                              BorderThickness="1" BorderBrush="{DynamicResource BorderColor}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Track Info" Width="280" DisplayMemberBinding="{Binding TrackInfo}"/>
                                <!-- Resolution: not currently functional; dropdown disabled pending implementation -->
                                <GridViewColumn Header="Resolution" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding Resolution, Mode=TwoWay}"
                                                      ItemsSource="{StaticResource VideoResolutionOptions}"
                                                      Width="100" IsEnabled="False"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!-- Output Format: hevc uses hevc_nvenc + 10-bit pipeline; h.264 uses h264_nvenc -->
                                <GridViewColumn Header="Output Format" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding OutputFormat, Mode=TwoWay}"
                                                      ItemsSource="{StaticResource VideoOutputFormatOptions}"
                                                      Width="130"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!-- Preset: p1=fastest/lowest quality through p7=slowest/highest quality -->
                                <GridViewColumn Header="Preset" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding Preset, Mode=TwoWay}"
                                                      ItemsSource="{StaticResource VideoPresetOptions}"
                                                      Width="80"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!-- Frame Rate: not currently functional; dropdown disabled pending implementation -->
                                <GridViewColumn Header="Frame Rate" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding FrameRate, Mode=TwoWay}"
                                                      ItemsSource="{StaticResource VideoFrameRateOptions}"
                                                      Width="120" IsEnabled="False"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock Grid.Row="3" Text="AUDIO" Style="{StaticResource SectionLabel}"/>

                    <ListView Grid.Row="4" x:Name="TranscodeAudioList"
                              BorderThickness="1" BorderBrush="{DynamicResource BorderColor}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Track Info" Width="300" DisplayMemberBinding="{Binding TrackInfo}"/>
                                <!-- Format: eac3 adds —–eac3 to options; Keep copies the stream -->
                                <GridViewColumn Header="Format" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding Format, Mode=TwoWay}"
                                                      ItemsSource="{StaticResource AudioFormatOptions}"
                                                      Width="100"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!-- Width: channel downmix target — disabled pending ffmpeg implementation -->
                                <GridViewColumn Header="Width" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding Width, Mode=TwoWay}"
                                                      ItemsSource="{StaticResource AudioWidthOptions}"
                                                      Width="100" IsEnabled="False"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!-- Bit Rate: used as -b:a when encoding; ignored when Format is Keep -->
                                <GridViewColumn Header="Bit Rate (Kbps)" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding BitRate, Mode=TwoWay}"
                                                      ItemsSource="{StaticResource AudioBitRateOptions}"
                                                      Width="120"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock Grid.Row="6" Text="SUBTITLES" Style="{StaticResource SectionLabel}"/>

                    <ListView Grid.Row="7" x:Name="TranscodeSubtitleList"
                              BorderThickness="1" BorderBrush="{DynamicResource BorderColor}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Track Info" Width="280" DisplayMemberBinding="{Binding TrackInfo}"/>
                                <GridViewColumn Header="# of Frames" Width="100" DisplayMemberBinding="{Binding FrameCount}"/>
                                <GridViewColumn Header="Default" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsDefault}" IsEnabled="False"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Forced" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsForced}" IsEnabled="False"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Burn" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Burn}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

            </Grid>
        </Grid>
    </DockPanel>
</Window>
