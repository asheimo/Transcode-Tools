<Window x:Class="TranscodeTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TranscodeTools"
        Title="Transcode Tools"
        Width="1000" Height="780"
        MinWidth="800" MinHeight="600"
        Background="{DynamicResource WindowBg}">

    <Window.Resources>
        <!-- Tab-like radio button style for mode switcher -->
        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource SurfaceBg}"
              BorderBrush="{DynamicResource SeparatorColor}"
              BorderThickness="0,0,0,1">
            <MenuItem Header="File">
                <MenuItem Header="Open Input Directory"  Click="OpenInputDirectory_Click"/>
                <MenuItem Header="Open Output Directory" Click="OpenOutputDirectory_Click"/>
                <Separator/>
                <MenuItem Header="Preferences"           Click="Preferences_Click"/>
                <Separator/>
                <MenuItem Header="Exit"                  Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Top toolbar: Mode switcher -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceBg}"
                BorderBrush="{DynamicResource SeparatorColor}"
                BorderThickness="0,0,0,1"
                Padding="12,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="User Mode:"
                           Foreground="{DynamicResource SubtleForeground}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <RadioButton x:Name="RemuxRadio"
                             Content="Remux"
                             Style="{StaticResource ModeRadio}"
                             IsChecked="True"
                             Checked="ModeChanged"/>
                <RadioButton x:Name="TranscodeRadio"
                             Content="Transcode"
                             Style="{StaticResource ModeRadio}"
                             Checked="ModeChanged"/>
            </StackPanel>
        </Border>

        <!-- Bottom button bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SurfaceBg}"
                BorderBrush="{DynamicResource SeparatorColor}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <!-- Remux buttons -->
            <StackPanel x:Name="RemuxButtons" Orientation="Horizontal">
                <Button x:Name="OpenInMPVBtn"
                        Content="Open in MPV"
                        Style="{StaticResource FlatButton}"
                        Margin="0,0,8,0"
                        Click="OpenInMPV_Click"/>
                <Button x:Name="OpenInSubtitleEditBtn"
                        Content="Open in Subtitleedit"
                        Style="{StaticResource FlatButton}"
                        Margin="0,0,8,0"
                        Click="OpenInSubtitleEdit_Click"/>
                <Button x:Name="OpenFolderBtn"
                        Content="Open Folder in Explorer"
                        Style="{StaticResource FlatButton}"
                        Margin="0,0,8,0"
                        Click="OpenFolderInExplorer_Click"/>
                <Button Content="Save Remux Settings"
                        Style="{StaticResource AccentButton}"
                        Margin="0,0,8,0"
                        Click="SaveSettings_Click"/>
                <!-- Transcode save button (hidden initially) -->
                <Button x:Name="SaveTranscodeBtn"
                        Content="Save Transcode Settings"
                        Style="{StaticResource AccentButton}"
                        Visibility="Collapsed"
                        Click="SaveSettings_Click"/>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <Grid Margin="12,10,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>    <!-- Directory row -->
                <RowDefinition Height="180"/>   <!-- File lists -->
                <RowDefinition Height="10"/>    <!-- Spacing -->
                <RowDefinition Height="*"/>     <!-- Track panels -->
            </Grid.RowDefinitions>

            <!-- Directory selectors -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Input Directory"
                            Style="{StaticResource FlatButton}"
                            Margin="0,0,6,0"
                            Click="OpenInputDirectory_Click"/>
                    <TextBox Grid.Column="1"
                             x:Name="InputDirectoryBox"
                             IsReadOnly="True"/>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Output Directory"
                            Style="{StaticResource FlatButton}"
                            Margin="0,0,6,0"
                            Click="OpenOutputDirectory_Click"/>
                    <TextBox Grid.Column="1"
                             x:Name="OutputDirectoryBox"
                             IsReadOnly="True"/>
                </Grid>
            </Grid>

            <!-- File list panels -->
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource PanelBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <ListBox x:Name="InputFileList"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource ForegroundColor}"
                             FontSize="13"
                             SelectionChanged="InputFileList_SelectionChanged"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource PanelBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <ListBox x:Name="OutputFileList"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource ForegroundColor}"
                             FontSize="13"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>

            <!-- Track panels - switch between Remux and Transcode -->
            <Grid Grid.Row="3">

                <!-- ===== REMUX MODE PANELS ===== -->
                <Grid x:Name="RemuxPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="80"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*" MinHeight="100"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.5*" MinHeight="80"/>
                    </Grid.RowDefinitions>

                    <!-- Video tracks label -->
                    <TextBlock Grid.Row="0"
                               Text="VIDEO"
                               Style="{StaticResource SectionLabel}"/>

                    <!-- Video tracks list -->
                    <ListView Grid.Row="1"
                              x:Name="RemuxVideoList"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource BorderColor}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="30">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Video Format" Width="180" DisplayMemberBinding="{Binding VideoFormat}"/>
                                <GridViewColumn Header="Resolution"   Width="150" DisplayMemberBinding="{Binding Resolution}"/>
                                <GridViewColumn Header="fps"          Width="80"  DisplayMemberBinding="{Binding Fps}"/>
                                <GridViewColumn Header="Default"      Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsDefault}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Audio tracks label -->
                    <TextBlock Grid.Row="3"
                               Text="AUDIO"
                               Style="{StaticResource SectionLabel}"/>

                    <!-- Audio tracks list -->
                    <ListView Grid.Row="4"
                              x:Name="RemuxAudioList"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource BorderColor}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="30">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Audio Format"    Width="150" DisplayMemberBinding="{Binding AudioFormat}"/>
                                <GridViewColumn Header="Width"           Width="80"  DisplayMemberBinding="{Binding Width}"/>
                                <GridViewColumn Header="Bit Rate (Kbps)" Width="110" DisplayMemberBinding="{Binding BitRate}"/>
                                <GridViewColumn Header="Language"        Width="90"  DisplayMemberBinding="{Binding Language}"/>
                                <GridViewColumn Header="Title"           Width="160" DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="Default"         Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsDefault}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Track ID" Width="70" DisplayMemberBinding="{Binding TrackId}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Subtitle tracks label -->
                    <TextBlock Grid.Row="6"
                               Text="SUBTITLES"
                               Style="{StaticResource SectionLabel}"/>

                    <!-- Subtitle tracks list -->
                    <ListView Grid.Row="7"
                              x:Name="RemuxSubtitleList"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource BorderColor}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="30">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Subtitle Format" Width="140" DisplayMemberBinding="{Binding SubtitleFormat}"/>
                                <GridViewColumn Header="Language"        Width="90"  DisplayMemberBinding="{Binding Language}"/>
                                <GridViewColumn Header="# of Frames"    Width="100" DisplayMemberBinding="{Binding FrameCount}"/>
                                <GridViewColumn Header="Title"           Width="160" DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="Default"         Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsDefault}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Forced" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsForced}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Track ID" Width="70" DisplayMemberBinding="{Binding TrackId}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <!-- ===== TRANSCODE MODE PANELS ===== -->
                <Grid x:Name="TranscodePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="80"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*" MinHeight="100"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.5*" MinHeight="80"/>
                    </Grid.RowDefinitions>

                    <!-- Video label -->
                    <TextBlock Grid.Row="0"
                               Text="VIDEO"
                               Style="{StaticResource SectionLabel}"/>

                    <!-- Transcode Video list -->
                    <ListView Grid.Row="1"
                              x:Name="TranscodeVideoList"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource BorderColor}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="30">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Track Info"     Width="350" DisplayMemberBinding="{Binding TrackInfo}"/>
                                <GridViewColumn Header="Resolution"     Width="120" DisplayMemberBinding="{Binding Resolution}"/>
                                <GridViewColumn Header="Output Format"  Width="130" DisplayMemberBinding="{Binding OutputFormat}"/>
                                <GridViewColumn Header="Frame Rate"     Width="100" DisplayMemberBinding="{Binding FrameRate}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Audio label -->
                    <TextBlock Grid.Row="3"
                               Text="AUDIO"
                               Style="{StaticResource SectionLabel}"/>

                    <!-- Transcode Audio list -->
                    <ListView Grid.Row="4"
                              x:Name="TranscodeAudioList"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource BorderColor}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="30">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Track Info"      Width="350" DisplayMemberBinding="{Binding TrackInfo}"/>
                                <GridViewColumn Header="Format"          Width="120" DisplayMemberBinding="{Binding Format}"/>
                                <GridViewColumn Header="Width"           Width="80"  DisplayMemberBinding="{Binding Width}"/>
                                <GridViewColumn Header="Bit Rate (Kbps)" Width="120" DisplayMemberBinding="{Binding BitRate}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Subtitles label -->
                    <TextBlock Grid.Row="6"
                               Text="SUBTITLES"
                               Style="{StaticResource SectionLabel}"/>

                    <!-- Transcode Subtitle list -->
                    <ListView Grid.Row="7"
                              x:Name="TranscodeSubtitleList"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource BorderColor}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="30">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Track Info" Width="380" DisplayMemberBinding="{Binding TrackInfo}"/>
                                <GridViewColumn Header="Default" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsDefault}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Forced" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsForced}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Burn" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Burn}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

            </Grid>
        </Grid>
    </DockPanel>
</Window>
