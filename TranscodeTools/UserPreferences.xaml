<!-- ============================================================
     UserPreferences.xaml
     ============================================================
     This is the User Preferences window. It lets the user set
     the paths to all the external tools the application needs,
     as well as default command-line option strings.

     Layout: A ScrollViewer containing a grid of rows.
     Each tool row has: Label | TextBox | [Where] [Browse]
     Options rows have: Label | TextBox (full width)
     ============================================================ -->
<Window x:Class="TranscodeTools.UserPreferences"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="User Preferences"
        Width="700" Height="620"
        MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBg}"
        GotKeyboardFocus="Window_GotKeyboardFocus">

    <Window.Resources>
        <!-- Label style for the left-hand column -->
        <Style x:Key="PrefLabel" TargetType="TextBlock">
            <Setter Property="Foreground"           Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="FontSize"             Value="13"/>
            <Setter Property="VerticalAlignment"    Value="Center"/>
            <Setter Property="Margin"               Value="0,0,10,0"/>
        </Style>

        <!-- Section header style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource SubtleForeground}"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,12,0,6"/>
        </Style>

        <!-- Small button for Where / Browse -->
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding"  Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin"   Value="4,0,0,0"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- OK / Cancel button bar at the bottom -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SurfaceBg}"
                BorderBrush="{DynamicResource SeparatorColor}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="BtnCancel"
                        Content="Cancel"
                        Style="{StaticResource FlatButton}"
                        Margin="0,0,8,0"
                        Width="80"
                        Click="BtnCancel_Click"/>
                <Button x:Name="BtnOK"
                        Content="OK"
                        Style="{StaticResource AccentButton}"
                        Width="80"
                        Click="BtnOK_Click"/>
            </StackPanel>
        </Border>

        <!-- Scrollable content area -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Padding="16,12,16,12">
            <StackPanel>

                <!-- ── TOOL PATHS section ─────────────────────── -->
                <TextBlock Text="TOOL PATHS"
                           Style="{StaticResource SectionHeader}"/>

                <Border Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>  <!-- Label -->
                            <ColumnDefinition Width="*"/>    <!-- TextBox -->
                            <ColumnDefinition Width="Auto"/> <!-- Where button -->
                            <ColumnDefinition Width="Auto"/> <!-- Browse button -->
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>

                        <!-- MPV -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="MPV"                Style="{StaticResource PrefLabel}"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TbxMPV"          VerticalContentAlignment="Center"/>
                        <Button    Grid.Row="0" Grid.Column="2" Content="Where"           Style="{StaticResource SmallButton}" Click="WhereMPV_Click"/>
                        <Button    Grid.Row="0" Grid.Column="3" Content="Browse"          Style="{StaticResource SmallButton}" Click="BrowseMPV_Click"/>

                        <!-- SubtitleEdit -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Subtitle Edit"      Style="{StaticResource PrefLabel}"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TbxSubtitleEdit"  VerticalContentAlignment="Center"/>
                        <Button    Grid.Row="1" Grid.Column="2" Content="Where"           Style="{StaticResource SmallButton}" Click="WhereSubtitleEdit_Click"/>
                        <Button    Grid.Row="1" Grid.Column="3" Content="Browse"          Style="{StaticResource SmallButton}" Click="BrowseSubtitleEdit_Click"/>

                        <!-- ffmpeg -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="ffmpeg"             Style="{StaticResource PrefLabel}"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TbxFFmpeg"        VerticalContentAlignment="Center"/>
                        <Button    Grid.Row="2" Grid.Column="2" Content="Where"           Style="{StaticResource SmallButton}" Click="WhereFFmpeg_Click"/>
                        <Button    Grid.Row="2" Grid.Column="3" Content="Browse"          Style="{StaticResource SmallButton}" Click="BrowseFFmpeg_Click"/>

                        <!-- ffprobe -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="ffprobe"            Style="{StaticResource PrefLabel}"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TbxFFprobe"       VerticalContentAlignment="Center"/>
                        <Button    Grid.Row="3" Grid.Column="2" Content="Where"           Style="{StaticResource SmallButton}" Click="WhereFFprobe_Click"/>
                        <Button    Grid.Row="3" Grid.Column="3" Content="Browse"          Style="{StaticResource SmallButton}" Click="BrowseFFprobe_Click"/>

                        <!-- MKVPropEdit -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="MKVPropEdit"        Style="{StaticResource PrefLabel}"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TbxMKVPropEdit"   VerticalContentAlignment="Center"/>
                        <Button    Grid.Row="4" Grid.Column="2" Content="Where"           Style="{StaticResource SmallButton}" Click="WhereMKVPropEdit_Click"/>
                        <Button    Grid.Row="4" Grid.Column="3" Content="Browse"          Style="{StaticResource SmallButton}" Click="BrowseMKVPropEdit_Click"/>

                        <!-- MKVMerge -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="MKVMerge"           Style="{StaticResource PrefLabel}"/>
                        <TextBox   Grid.Row="5" Grid.Column="1" x:Name="TbxMKVMerge"      VerticalContentAlignment="Center"/>
                        <Button    Grid.Row="5" Grid.Column="2" Content="Where"           Style="{StaticResource SmallButton}" Click="WhereMKVMerge_Click"/>
                        <Button    Grid.Row="5" Grid.Column="3" Content="Browse"          Style="{StaticResource SmallButton}" Click="BrowseMKVMerge_Click"/>

                    </Grid>
                </Border>

                <!-- ── OPTIONS section ────────────────────────── -->
                <TextBlock Text="DEFAULT OPTIONS"
                           Style="{StaticResource SectionHeader}"/>

                <Border Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="MKVMerge Defaults"        Style="{StaticResource PrefLabel}"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TbxMKVMergeDefaults"    VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="MKVMerge Options"         Style="{StaticResource PrefLabel}"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TbxMKVMergeOptions"     VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="RoboCopy Defaults"        Style="{StaticResource PrefLabel}"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TbxRoboCopyDefaults"    VerticalContentAlignment="Center"/>

                        <!-- Default NVENC Preset -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Default NVENC Preset"  Style="{StaticResource PrefLabel}"/>
                        <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="CbxDefaultPreset"
                                   VerticalContentAlignment="Center"
                                   Width="80" HorizontalAlignment="Left">
                            <sys:String>None</sys:String>
                            <sys:String>p1</sys:String>
                            <sys:String>p2</sys:String>
                            <sys:String>p3</sys:String>
                            <sys:String>p4</sys:String>
                            <sys:String>p5</sys:String>
                            <sys:String>p6</sys:String>
                            <sys:String>p7</sys:String>
                        </ComboBox>

                        <!-- NVENC Quality Flags -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="NVENC Quality Flags"      Style="{StaticResource PrefLabel}"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TbxNvencQualityFlags"   VerticalContentAlignment="Center"/>

                        <!-- Always Convert to HEVC -->
                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                    Margin="0,8,0,4">
                            <CheckBox x:Name="ChkAlwaysConvertToHevc"
                                      Content="Always Convert to HEVC"
                                      HorizontalAlignment="Left"/>
                            <TextBlock Text="When checked, files without saved settings will be transcoded using defaults (hevc, preset as configured above, all audio copy). When unchecked, files without saved settings will be robocopied."
                                       Foreground="{DynamicResource SubtleForeground}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="22,4,0,0"/>
                        </StackPanel>

                    </Grid>
                </Border>


                <!-- ── GENERAL section ───────────────────────────── -->
                <TextBlock Text="GENERAL"
                           Style="{StaticResource SectionHeader}"/>

                <Border Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Folder History Size"
                                   Style="{StaticResource PrefLabel}"/>
                        <TextBox   Grid.Row="0" Grid.Column="1"
                                   x:Name="TbxHistorySize"
                                   VerticalContentAlignment="Center"
                                   PreviewTextInput="HistorySize_PreviewTextInput"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="(applies to both Input and Output history)"
                                   Style="{StaticResource PrefLabel}"
                                   Foreground="{DynamicResource SubtleForeground}"
                                   FontSize="11"/>
                    </Grid>
                </Border>

                <!-- ── FILE NAME CORRECTIONS section ─────────────── -->
                <TextBlock Text="FILE NAME CORRECTIONS"
                           Style="{StaticResource SectionHeader}"/>

                <Border Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,8">
                    <StackPanel>

                        <!-- Title Case -->
                        <CheckBox x:Name="ChkTitleCase"
                                  Content="Auto Title Case on Folder Load"
                                  HorizontalAlignment="Left"
                                  Margin="0,4,0,4"/>
                        <TextBlock Text="Corrects folder and file display names to Title Case on load. A confirmation dialog lets you review and selectively apply changes."
                                   Foreground="{DynamicResource SubtleForeground}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="22,0,0,8"/>

                        <TextBlock Text="Acronym List (comma-separated, e.g. HDR,UHD,IMAX):"
                                   Foreground="{DynamicResource ForegroundColor}"
                                   FontSize="12"
                                   Margin="22,0,0,4"/>
                        <TextBox x:Name="TbxAcronyms"
                                 Margin="22,0,0,12"
                                 VerticalContentAlignment="Center"/>

                        <!-- Resolution Append -->
                        <CheckBox x:Name="ChkResolutionAppend"
                                  Content="Auto-Append Resolution to Movie Filenames"
                                  HorizontalAlignment="Left"
                                  Margin="0,4,0,4"/>
                        <TextBlock Text="Probes movie files with ffprobe on folder load and appends resolution label (e.g. -1080p) to filenames that lack one. Movies only — not TV."
                                   Foreground="{DynamicResource SubtleForeground}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="22,0,0,4"/>

                        <CheckBox x:Name="ChkResolutionVerifyAlways"
                                  HorizontalAlignment="Left"
                                  Content="Verify resolution of all files via ffprobe (slower — probes all files including those with existing resolution suffix)"
                                  Margin="22,4,0,8"
                                  Foreground="{DynamicResource SubtleForeground}"
                                  FontSize="11"/>

                    </StackPanel>
                </Border>

                <!-- ── RUN section ───────────────────────────────────── -->
                <TextBlock Text="RUN"
                           Style="{StaticResource SectionHeader}"/>

                <Border Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,8">
                    <StackPanel>

                        <!-- Write Log Files -->
                        <CheckBox x:Name="ChkWriteLogFiles"
                                  Content="Write Log Files"
                                  HorizontalAlignment="Left"
                                  Margin="0,4,0,4"
                                  Checked="ChkWriteLogFiles_Changed"
                                  Unchecked="ChkWriteLogFiles_Changed"/>
                        <TextBlock Text="Writes a log file per processed file to &lt;OutputDirectory&gt;\Logs\&lt;timestamp&gt;\. Failed files are named with a -FAILED suffix."
                                   Foreground="{DynamicResource SubtleForeground}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="22,0,0,8"/>

                        <!-- Verbose Logging — indented under Write Log Files -->
                        <CheckBox x:Name="ChkVerboseLogging"
                                  Content="Verbose Logging"
                                  HorizontalAlignment="Left"
                                  Margin="22,4,0,4"
                                  IsEnabled="False"
                                  Checked="ChkVerboseLogging_Changed"
                                  Unchecked="ChkVerboseLogging_Changed"/>
                        <TextBlock Text="When enabled, ffmpeg output is redirected to the log file at the selected log level. The Run window shows an indeterminate progress bar instead of stats."
                                   Foreground="{DynamicResource SubtleForeground}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="44,0,0,8"/>

                        <!-- ffmpeg Log Level -->
                        <StackPanel Orientation="Horizontal" Margin="22,0,0,8">
                            <TextBlock Text="ffmpeg Log Level:"
                                       Style="{StaticResource PrefLabel}"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="CbxFfmpegLogLevel"
                                      VerticalContentAlignment="Center"
                                      Width="90"
                                      IsEnabled="False">
                                <sys:String>warning</sys:String>
                                <sys:String>info</sys:String>
                                <sys:String>verbose</sys:String>
                                <sys:String>debug</sys:String>
                            </ComboBox>
                        </StackPanel>

                        <!-- Disable automatic move of completed folders -->
                        <CheckBox x:Name="ChkAutoMoveCompleted"
                                  Content="Disable automatic move of completed folders"
                                  HorizontalAlignment="Left"
                                  Margin="0,8,0,4"
                                  Checked="ChkAutoMoveCompleted_Changed"
                                  Unchecked="ChkAutoMoveCompleted_Changed"/>
                        <TextBlock Text="When checked, completed output folders will not be automatically moved to a Completed\ subfolder after a run. By default, folders whose files all succeeded are moved automatically."
                                   Foreground="{DynamicResource SubtleForeground}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="22,0,0,8"/>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
