<!-- ============================================================
     RipView.xaml
     Rip mode's content. Shown by MainWindow in place of the shared
     Remux/Transcode layout when the "Rip" mode button is checked.

     Layout, top to bottom:
       Destination line  |  Hide complete discs
       drives box        |  disc list (the jobs list)
       player
       the selected disc's titles
       status line

     Splitters sit between the top band and the player, and between
     the player and the titles, so either can be given more of the
     window's height. The top band has its own column splitter, which
     moves the Destination line with the drives box, so the two tables
     start and end on the same lines.

     The player plays the disc loaded from the disc list (Load Disc).
     It takes the arrow keys and Enter while it has focus; clicking it
     gives it focus.

     A drive row's button reads Backup, Cancel, Eject or Log by the
     row's backup state; the row fills green with the backup's
     progress and turns red when it fails. A job row turns red when
     its job fails; its text keeps the theme colour.
     ============================================================ -->
<UserControl x:Class="TranscodeTools.RipView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TranscodeTools"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Loaded="RipView_Loaded"
             Unloaded="RipView_Unloaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBoolConverter x:Key="InverseBool"/>

        <!-- Right-click menu on a disc row. x:Shared="False" gives each row
             its own instance; one shared ContextMenu can only have one parent.
             Cancel stops a running info job. -->
        <ContextMenu x:Key="JobRowMenu" x:Shared="False">
            <MenuItem Header="Open Folder in Explorer" Click="OpenDiscFolder_Click"/>
            <MenuItem Header="Cancel"
                      IsEnabled="{Binding IsRunning}"
                      Click="CancelJob_Click"/>
        </ContextMenu>

        <!-- Title rows: the theme's DataGridRow style, the row's note as its
             tooltip, and selection that follows the keyboard into the row's
             Type box. -->
        <Style x:Key="TitleRowStyle" TargetType="DataGridRow"
               BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="ToolTip" Value="{Binding Note}"/>
            <EventSetter Event="PreviewGotKeyboardFocus" Handler="TitleRow_PreviewGotKeyboardFocus"/>
        </Style>

        <!-- Column header and cell text centred, for Runtime -->
        <Style x:Key="CenteredColumnHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CenteredCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Three-dot grip, same look as the main window's splitter -->
        <ControlTemplate x:Key="GripSplitter" TargetType="GridSplitter">
            <Grid Background="Transparent">
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource SubtleForeground}" Margin="0,2,0,2"/>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource SubtleForeground}" Margin="0,2,0,2"/>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource SubtleForeground}" Margin="0,2,0,2"/>
                </StackPanel>
            </Grid>
        </ControlTemplate>

        <!-- Same grip lying down, for the splitter between the drives/jobs
             band and the row below it. -->
        <ControlTemplate x:Key="GripSplitterH" TargetType="GridSplitter">
            <Grid Background="Transparent">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource SubtleForeground}" Margin="2,0,2,0"/>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource SubtleForeground}" Margin="2,0,2,0"/>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource SubtleForeground}" Margin="2,0,2,0"/>
                </StackPanel>
            </Grid>
        </ControlTemplate>

        <!-- Job status cell: the theme's foreground in every state. A
             failure shows on the row's background, not on the text. -->
        <Style x:Key="JobStatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Row colours come from RipColors in code: the theme is frozen, so
             they are local, and translucent so the theme text stays legible.
             They are set by style triggers because the theme's own hover and
             selection colours are template triggers, which a style trigger
             outranks; a plain setter would be hidden by hover. -->
        <Style x:Key="DriveRowStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasRowBrush}" Value="True">
                    <Setter Property="Background" Value="{Binding RowBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="JobRowStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="ContextMenu" Value="{StaticResource JobRowMenu}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Background" Value="{x:Static local:RipColors.FailedRow}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150" MinHeight="110"/>   <!-- Destination | hide; drives | discs -->
            <RowDefinition Height="8"/>                     <!-- Splitter -->
            <RowDefinition Height="*" MinHeight="180"/>     <!-- Player -->
            <RowDefinition Height="8"/>                     <!-- Splitter -->
            <RowDefinition Height="200" MinHeight="120"/>   <!-- Selected disc's titles -->
            <RowDefinition Height="Auto"/>                  <!-- Status -->
        </Grid.RowDefinitions>

        <!-- Top band: two columns and one splitter -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>   <!-- Destination | Hide complete discs -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>    <!-- Drives | discs -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="250"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- Destination line: same picker design as Input/Output Directory,
                 with the button sized to its text -->
            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Destination"
                        Style="{StaticResource FlatButton}"
                        Margin="0,0,6,0"
                        Click="DestinationButton_Click"/>
                <ComboBox Grid.Column="1"
                          x:Name="DestinationBox"
                          IsEditable="True"
                          IsReadOnly="True"
                          SelectionChanged="DestinationBox_SelectionChanged"/>
            </Grid>

            <!-- Filters complete discs out of the list below. Saved in settings. -->
            <CheckBox Grid.Row="0" Grid.Column="2"
                      x:Name="HideCompleteCheck"
                      Content="Hide complete discs"
                      HorizontalAlignment="Left"
                      Checked="HideComplete_Changed"
                      Unchecked="HideComplete_Changed"/>

            <!-- Drives box. The button stays visible on every row; it is
                 disabled only for a drive with no disc, and its tooltip
                 says what it will do or why it cannot. -->
            <ListView Grid.Row="2" Grid.Column="0"
                      x:Name="DriveList"
                      ItemContainerStyle="{StaticResource DriveRowStyle}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Drive" Width="60"  DisplayMemberBinding="{Binding Letter}"/>
                        <GridViewColumn Header="Disc"  Width="180" DisplayMemberBinding="{Binding Label}"/>
                        <!-- The backup's progress while it runs -->
                        <GridViewColumn Header="%" Width="50">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Percent}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header=""      Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ButtonText}"
                                            Style="{StaticResource FlatButton}"
                                            Padding="12,2"
                                            IsEnabled="{Binding CanPress}"
                                            ToolTip="{Binding ButtonHint}"
                                            ToolTipService.ShowOnDisabled="True"
                                            Click="DriveButton_Click"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Column="1" Grid.RowSpan="3"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="Transparent"
                          Template="{StaticResource GripSplitter}"/>

            <!-- Discs: one row per disc on the Destination, rebuilt from disk
                 when a Destination loads. Selecting a row does nothing more
                 than select it. Status is Ready or Playing (a running or
                 failed job's message while there is one); Tracks is the number
                 of titles VLC lists, once the disc has been loaded. Load Disc
                 plays the disc and lists its titles below; Stop stops it. The
                 right-click menu runs the chain again from Analyse. -->
            <ListView Grid.Row="2" Grid.Column="2"
                      x:Name="JobList"
                      SelectionMode="Single"
                      ItemContainerStyle="{StaticResource JobRowStyle}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Disc" Width="180"
                                        DisplayMemberBinding="{Binding Disc, TargetNullValue=''}"/>
                        <GridViewColumn Header="Status" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource JobStatusText}"
                                               Text="{Binding ShownStatus, TargetNullValue=''}"
                                               ToolTip="{Binding ShownStatus, TargetNullValue=''}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Tracks" Width="60"
                                        DisplayMemberBinding="{Binding Tracks, TargetNullValue=''}"/>
                        <!-- Load Disc / Stop. Disabled while the disc's chain runs. -->
                        <GridViewColumn Header="" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding PlayText}"
                                            Style="{StaticResource FlatButton}"
                                            Padding="12,2"
                                            IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"
                                            Click="PlayButton_Click"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- Splitter between the drives/jobs band and the player -->
        <GridSplitter Grid.Row="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Background="Transparent"
                      Template="{StaticResource GripSplitterH}"/>

        <!-- The player. The frame takes keyboard focus for the disc's menus.
             VLC draws into VideoView's native window, which WPF can't draw
             over; only VideoView's overlay (its content) sits above it. The
             VideoView is never collapsed: it hands VLC its window handle when
             the player is attached, and a collapsed one has none yet, which
             sends VLC to a window of its own. While nothing plays, the cover
             in the overlay hides the empty video window. The overlay's
             near-transparent background (alpha 1) is what makes it take the
             click that gives the player focus: fully transparent pixels of a
             layered window pass clicks through to the window below.
             The frame's border turns green while the player has the keys, the
             same green the file list uses for a file with saved settings. It is always 2 px, so focus never resizes the video. -->
        <Border Grid.Row="2"
                x:Name="PlayerFrame"
                Focusable="True"
                FocusVisualStyle="{x:Null}"
                Background="{DynamicResource PanelBg}"
                CornerRadius="4"
                PreviewKeyDown="Player_PreviewKeyDown"
                MouseDown="Player_MouseDown"
                LostKeyboardFocus="PlayerFrame_LostKeyboardFocus">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="Green"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <vlc:VideoView x:Name="PlayerVideo">
                    <Grid Background="#01000000"
                          PreviewKeyDown="Player_PreviewKeyDown"
                          MouseDown="Player_MouseDown">
                        <Border x:Name="PlayerCover"
                                Background="{DynamicResource PanelBg}">
                            <TextBlock x:Name="PlayerPlaceholder"
                                       Foreground="{DynamicResource SubtleForeground}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="24"/>
                        </Border>
                    </Grid>
                </vlc:VideoView>
            </Grid>
        </Border>

        <!-- Splitter between the player and the list -->
        <GridSplitter Grid.Row="3"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Background="Transparent"
                      Template="{StaticResource GripSplitterH}"/>

        <!-- The selected disc's titles -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Shown only while a disc's titles are listed -->
            <Grid x:Name="DiscTitlesHeader" Grid.Row="0"
                  Margin="0,0,0,6"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           x:Name="SelectedDiscName"
                           Foreground="{DynamicResource ForegroundColor}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Saves every changed row's name and type to the disc's record.
                     Enabled only while there is a change. On a complete disc it
                     reads Edit and reopens the disc. -->
                <Button Grid.Column="1"
                        x:Name="ApplyButton"
                        Content="Apply"
                        Style="{StaticResource AccentButton}"
                        Padding="16,3"
                        IsEnabled="False"
                        Click="Apply_Click"/>
                <!-- Marks the disc complete. Disabled while there are changes
                     not yet applied, and on a disc already complete. -->
                <Button Grid.Column="2"
                        x:Name="CompleteButton"
                        Content="Complete"
                        Style="{StaticResource AccentButton}"
                        Padding="16,3"
                        Margin="8,0,0,0"
                        IsEnabled="False"
                        Click="Complete_Click"/>
            </Grid>

            <!-- Shown while no disc is selected above, or for a disc whose info
                 run has not finished -->
            <TextBlock Grid.Row="1"
                       x:Name="TitlesPlaceholder"
                       Foreground="{DynamicResource SubtleForeground}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- One row per title MakeMKV's info run joined, in title order,
                 from the disc's record. The Name cell edits in place (one click
                 or F2, Enter to keep, Esc to undo) and the Type dropdown sets
                 Main title or a Plex extras type. A click anywhere else in the
                 row only selects it. Runtime is fixed-width and centred. -->
            <DataGrid Grid.Row="1"
                      x:Name="TitleList"
                      Visibility="Collapsed"
                      RowStyle="{StaticResource TitleRowStyle}"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      PreparingCellForEdit="TitleList_PreparingCellForEdit"
                      CellEditEnding="TitleList_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Width="50" IsReadOnly="True"
                                        Binding="{Binding Number}"/>
                    <DataGridTextColumn Header="Runtime" Width="80" IsReadOnly="True" CanUserResize="False"
                                        Binding="{Binding Runtime}"
                                        HeaderStyle="{StaticResource CenteredColumnHeader}"
                                        ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn x:Name="NameColumn" Header="Name" Width="*"
                                        Binding="{Binding Name}"
                                        EditingElementStyle="{StaticResource DataGridEditingTextBox}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell"
                                   BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <!-- One click in a Name cell starts editing it -->
                                <EventSetter Event="PreviewMouseLeftButtonDown"
                                             Handler="NameCell_PreviewMouseLeftButtonDown"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <!-- Main title or a Plex extras type. Empty until chosen;
                         disabled on a complete disc. -->
                    <DataGridTemplateColumn Header="Type" Width="160" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding TypeChoices}"
                                          SelectedItem="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="Label"
                                          Padding="6,1"
                                          Margin="2,1">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Status line -->
        <TextBlock Grid.Row="5"
                   x:Name="StatusText"
                   Foreground="{DynamicResource SubtleForeground}"
                   FontSize="12"
                   Margin="0,6,0,0"
                   TextTrimming="CharacterEllipsis"/>
    </Grid>
</UserControl>
