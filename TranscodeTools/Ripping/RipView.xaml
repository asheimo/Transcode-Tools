<!-- ============================================================
     RipView.xaml
     Rip mode's content. Shown by MainWindow in place of the shared
     Remux/Transcode layout when the "Rip" mode button is checked.

     Layout:
       Destination line (full width)
       drives box            |  jobs in flight
       left column (270)     |  chip strip (fixed height)
         discs -> disc titles|  menu picture
       status line

     The drives/jobs band and the main row each have their own
     splitter, so the drives box is sized independently of the disc
     column below it.

     A drive row's button reads Backup, Cancel, Eject or Log by the
     row's backup state; the row fills green with the backup's
     progress and turns red when it fails. A job row turns red when
     its job fails; its text keeps the theme colour.
     ============================================================ -->
<UserControl x:Class="TranscodeTools.RipView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TranscodeTools"
             Loaded="RipView_Loaded"
             Unloaded="RipView_Unloaded">

    <UserControl.Resources>
        <!-- Right-click menu on a disc row. x:Shared="False" gives each row
             its own instance; one shared ContextMenu can only have one parent. -->
        <ContextMenu x:Key="DiscRowMenu" x:Shared="False">
            <MenuItem Header="Open Folder in Explorer" Click="OpenDiscFolder_Click"/>
        </ContextMenu>

        <!-- Disc rows: the theme's ListViewItem style plus the right-click menu.
             BasedOn keeps the theme template; without it this style would
             replace it. -->
        <Style x:Key="DiscRowStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="ContextMenu" Value="{StaticResource DiscRowMenu}"/>
        </Style>

        <!-- Three-dot grip, same look as the main window's splitter -->
        <ControlTemplate x:Key="GripSplitter" TargetType="GridSplitter">
            <Grid Background="Transparent">
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource SubtleForeground}" Margin="0,2,0,2"/>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource SubtleForeground}" Margin="0,2,0,2"/>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource SubtleForeground}" Margin="0,2,0,2"/>
                </StackPanel>
            </Grid>
        </ControlTemplate>

        <!-- Same grip lying down, for the splitter between the drives/jobs
             band and the row below it. -->
        <ControlTemplate x:Key="GripSplitterH" TargetType="GridSplitter">
            <Grid Background="Transparent">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource SubtleForeground}" Margin="2,0,2,0"/>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource SubtleForeground}" Margin="2,0,2,0"/>
                    <Ellipse Width="4" Height="4" Fill="{DynamicResource SubtleForeground}" Margin="2,0,2,0"/>
                </StackPanel>
            </Grid>
        </ControlTemplate>

        <!-- Job status cell: the theme's foreground in every state. A
             failure shows on the row's background, not on the text. -->
        <Style x:Key="JobStatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Row colours come from RipColors in code: the theme is frozen, so
             they are local, and translucent so the theme text stays legible.
             They are set by style triggers because the theme's own hover and
             selection colours are template triggers, which a style trigger
             outranks; a plain setter would be hidden by hover. -->
        <Style x:Key="DriveRowStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasRowBrush}" Value="True">
                    <Setter Property="Background" Value="{Binding RowBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="JobRowStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Background" Value="{x:Static local:RipColors.FailedRow}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Screen chip: one per source screen in the strip above the picture.
             The checked chip is the screen being shown. Foreground reaches the
             content through TextElement.Foreground, as custom templates must. -->
        <Style x:Key="ChipRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{DynamicResource ButtonBg}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" MinWidth="180"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*" MinWidth="240"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>                    <!-- Destination -->
            <RowDefinition Height="110" MinHeight="70"/>    <!-- Drives | jobs -->
            <RowDefinition Height="8"/>                     <!-- Splitter -->
            <RowDefinition Height="*" MinHeight="180"/>     <!-- Left column | chips + picture -->
            <RowDefinition Height="Auto"/>                  <!-- Status -->
        </Grid.RowDefinitions>

        <!-- Destination line: same picker design as Input/Output Directory -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Destination"
                    Style="{StaticResource FlatButton}"
                    Width="130"
                    Margin="0,0,6,0"
                    Click="DestinationButton_Click"/>
            <ComboBox Grid.Column="1"
                      x:Name="DestinationBox"
                      IsEditable="True"
                      IsReadOnly="True"
                      SelectionChanged="DestinationBox_SelectionChanged"/>
        </Grid>

        <!-- Drives | jobs band: its own columns and splitter, so the drives
             box is sized independently of the disc column below -->
        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" MinWidth="250"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- Drives box. The button stays visible on every row; it is
                 disabled only for a drive with no disc, and its tooltip
                 says what it will do or why it cannot. -->
            <ListView Grid.Column="0"
                      x:Name="DriveList"
                      ItemContainerStyle="{StaticResource DriveRowStyle}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Drive" Width="60"  DisplayMemberBinding="{Binding Letter}"/>
                        <GridViewColumn Header="Disc"  Width="180" DisplayMemberBinding="{Binding Label}"/>
                        <GridViewColumn Header=""      Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ButtonText}"
                                            Style="{StaticResource FlatButton}"
                                            Padding="12,2"
                                            IsEnabled="{Binding CanPress}"
                                            ToolTip="{Binding ButtonHint}"
                                            ToolTipService.ShowOnDisabled="True"
                                            Click="DriveButton_Click"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="Transparent"
                          Template="{StaticResource GripSplitter}"/>

            <!-- Jobs: one row per backed-up disc. Start runs the IFO read,
                 Cancel stops it, and a finished row keeps its result. -->
            <ListView Grid.Column="2"
                      x:Name="JobList"
                      ItemContainerStyle="{StaticResource JobRowStyle}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Disc" Width="180"
                                        DisplayMemberBinding="{Binding Disc, TargetNullValue=''}"/>
                        <GridViewColumn Header="Step" Width="90"
                                        DisplayMemberBinding="{Binding Step, TargetNullValue=''}"/>
                        <GridViewColumn Header="Status" Width="230">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource JobStatusText}"
                                               Text="{Binding Status, TargetNullValue=''}"
                                               ToolTip="{Binding Status, TargetNullValue=''}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ActionText}"
                                            Style="{StaticResource FlatButton}"
                                            Padding="12,2"
                                            Visibility="{Binding ActionVisibility}"
                                            Click="JobAction_Click"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- Splitter between the drives/jobs band and the row below.
             The two boxes share the band's height, so a machine with
             several drives can be given more of it. -->
        <GridSplitter Grid.Row="2" Grid.ColumnSpan="3"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Background="Transparent"
                      Template="{StaticResource GripSplitterH}"/>

        <!-- Splitter for the disc column and the picture side -->
        <GridSplitter Grid.Row="3" Grid.Column="1"
                      Margin="0,8,0,0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Background="Transparent"
                      Template="{StaticResource GripSplitter}"/>

        <!-- Left column: disc list, switching to the selected disc's titles -->
        <Grid Grid.Row="3" Grid.Column="0" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Shown only while a disc's titles are listed -->
            <Grid x:Name="DiscTitlesHeader" Grid.Row="0"
                  Margin="0,0,0,6"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Back to discs"
                        Style="{StaticResource FlatButton}"
                        Padding="8,3"
                        Margin="0,0,8,0"
                        Click="BackToDiscs_Click"/>
                <TextBlock Grid.Column="1"
                           x:Name="SelectedDiscName"
                           Foreground="{DynamicResource ForegroundColor}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>

            <ListView Grid.Row="1"
                      x:Name="DiscList"
                      ItemContainerStyle="{StaticResource DiscRowStyle}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectionChanged="DiscList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Disc" Width="250"
                                        DisplayMemberBinding="{Binding Name, TargetNullValue=''}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- One line per disc title: number, runtime, filename -->
            <ListView Grid.Row="1"
                      x:Name="TitleList"
                      Visibility="Collapsed"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectionChanged="TitleList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="#"       Width="36"
                                        DisplayMemberBinding="{Binding Number}"/>
                        <GridViewColumn Header="Runtime" Width="70"
                                        DisplayMemberBinding="{Binding Duration, TargetNullValue=''}"/>
                        <GridViewColumn Header="File"    Width="150"
                                        DisplayMemberBinding="{Binding FileName, TargetNullValue=''}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- Right side: chip strip above the menu picture -->
        <Grid Grid.Row="3" Grid.Column="2" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>   <!-- Chip strip: fixed so the picture never moves -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>    <!-- Picture -->
            </Grid.RowDefinitions>

            <!-- One chip per source screen, in the order the screens were found -->
            <ScrollViewer Grid.Row="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ChipStrip">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource ChipRadio}"
                                         GroupName="ScreenChips"
                                         Content="{Binding Label}"
                                         ToolTip="{Binding ToolTip}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Checked="Chip_Checked"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{DynamicResource PanelBg}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <TextBlock x:Name="PicturePlaceholder"
                               Foreground="{DynamicResource SubtleForeground}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="24"/>

                    <!-- The picture and the hotspot layer share one container, sized in
                         code to the picture's own pixels (720 x 480 NTSC, 720 x 576 PAL),
                         so button rectangles stay in source coordinates. The Viewbox
                         scales the pair together: StretchDirection="DownOnly" shrinks
                         it when space is short and never enlarges it. -->
                    <Viewbox x:Name="PictureBox"
                             Stretch="Uniform"
                             StretchDirection="DownOnly"
                             Visibility="Collapsed">
                        <Grid x:Name="PictureFrame">
                            <Image x:Name="MenuImage"
                                   Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Canvas x:Name="HotspotLayer"/>
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>

        <!-- Status line -->
        <TextBlock Grid.Row="4" Grid.ColumnSpan="3"
                   x:Name="StatusText"
                   Foreground="{DynamicResource SubtleForeground}"
                   FontSize="12"
                   Margin="0,6,0,0"
                   TextTrimming="CharacterEllipsis"/>
    </Grid>
</UserControl>
