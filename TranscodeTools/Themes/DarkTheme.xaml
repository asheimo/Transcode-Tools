<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBg"        Color="#1C1C1C"/>
    <SolidColorBrush x:Key="SurfaceBg"       Color="#2D2D2D"/>
    <SolidColorBrush x:Key="PanelBg"         Color="#252525"/>
    <SolidColorBrush x:Key="HeaderBg"        Color="#333333"/>
    <SolidColorBrush x:Key="InputBg"         Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ButtonBg"        Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ButtonHoverBg"   Color="#454545"/>
    <SolidColorBrush x:Key="ButtonPressedBg" Color="#555555"/>
    <SolidColorBrush x:Key="ForegroundColor" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="SubtleForeground" Color="#999999"/>
    <SolidColorBrush x:Key="BorderColor"     Color="#444444"/>
    <SolidColorBrush x:Key="RowDivider"      Color="#333333"/>
    <SolidColorBrush x:Key="RowHoverBg"      Color="#2A3A52"/>
    <SolidColorBrush x:Key="RowSelectedBg"   Color="#1A4A7A"/>
    <SolidColorBrush x:Key="AccentColor"     Color="#4CA3F5"/>
    <SolidColorBrush x:Key="SeparatorColor"  Color="#3A3A3A"/>

</ResourceDictionary>
