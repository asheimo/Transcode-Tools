<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBg"        Color="#F3F3F3"/>
    <SolidColorBrush x:Key="SurfaceBg"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBg"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBg"        Color="#EBEBEB"/>
    <SolidColorBrush x:Key="InputBg"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBg"        Color="#EBEBEB"/>
    <SolidColorBrush x:Key="ButtonHoverBg"   Color="#DEDEDE"/>
    <SolidColorBrush x:Key="ButtonPressedBg" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="ForegroundColor" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SubtleForeground" Color="#666666"/>
    <SolidColorBrush x:Key="BorderColor"     Color="#D0D0D0"/>
    <SolidColorBrush x:Key="RowDivider"      Color="#EEEEEE"/>
    <SolidColorBrush x:Key="RowHoverBg"      Color="#F0F4FF"/>
    <SolidColorBrush x:Key="RowSelectedBg"   Color="#D6E4FF"/>
    <SolidColorBrush x:Key="AccentColor"     Color="#0078D4"/>
    <SolidColorBrush x:Key="SeparatorColor"  Color="#E0E0E0"/>

</ResourceDictionary>
